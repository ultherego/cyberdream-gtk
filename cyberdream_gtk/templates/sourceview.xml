<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by cyberdream-gtk from palette.toml and roles.toml.
     Do not edit; change the sources and rebuild.
     Only opaque colors here (use mix, not alpha): style schemes need #rrggbb. -->
<style-scheme id="cyberdream" name="Cyberdream" version="1.0" kind="dark">
  <author>cyberdream-gtk</author>
  <description>Cyberdream colors for GtkSourceView</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <!-- Editor -->
  <style name="text"                foreground="{{text}}" background="{{view_bg}}"/>
  <style name="cursor"              foreground="{{accent}}"/>
  <style name="selection"           background="{{mix(view_bg, accent, 0.3)}}"/>
  <style name="current-line"        background="{{raised_bg}}"/>
  <style name="current-line-number" foreground="{{accent}}" background="{{raised_bg}}" bold="true"/>
  <style name="line-numbers"        foreground="{{muted}}" background="{{view_bg}}"/>
  <style name="line-numbers-border" background="{{border}}"/>
  <style name="right-margin"        foreground="{{border}}" background="{{sidebar_bg}}"/>
  <style name="background-pattern"  background="{{raised_bg}}"/>
  <style name="draw-spaces"         foreground="{{border}}"/>
  <style name="bracket-match"       foreground="{{accent}}" bold="true" underline="single"/>
  <style name="bracket-mismatch"    foreground="{{error}}" bold="true" underline="error"/>
  <style name="search-match"        foreground="{{on_accent}}" background="{{yellow}}"/>
  <style name="quick-highlight-match" background="{{mix(view_bg, blue, 0.35)}}"/>
  <style name="snippet-focus"       background="{{mix(view_bg, accent, 0.2)}}"/>
  <style name="map-overlay"         background="{{border}}"/>

  <!-- Diff -->
  <style name="diff:added-line"     foreground="{{green}}"/>
  <style name="diff:removed-line"   foreground="{{red}}"/>
  <style name="diff:changed-line"   foreground="{{yellow}}"/>
  <style name="diff:location"       foreground="{{cyan}}"/>
  <style name="diff:diff-file"      foreground="{{blue}}" bold="true"/>
  <style name="diff:special-case"   foreground="{{magenta}}"/>

  <!-- Syntax -->
  <style name="def:comment"         foreground="{{muted}}" italic="true"/>
  <style name="def:shebang"         foreground="{{muted}}" bold="true"/>
  <style name="def:doc-comment-element" foreground="{{cyan}}" italic="true"/>
  <style name="def:string"          foreground="{{green}}"/>
  <style name="def:special-char"    foreground="{{pink}}"/>
  <style name="def:constant"        foreground="{{pink}}"/>
  <style name="def:special-constant" foreground="{{pink}}"/>
  <style name="def:number"          foreground="{{orange}}"/>
  <style name="def:floating-point"  foreground="{{orange}}"/>
  <style name="def:decimal"         foreground="{{orange}}"/>
  <style name="def:base-n-integer"  foreground="{{orange}}"/>
  <style name="def:boolean"         foreground="{{cyan}}"/>
  <style name="def:keyword"         foreground="{{orange}}"/>
  <style name="def:statement"       foreground="{{magenta}}"/>
  <style name="def:operator"        foreground="{{magenta}}"/>
  <style name="def:builtin"         foreground="{{cyan}}"/>
  <style name="def:function"        foreground="{{blue}}"/>
  <style name="def:identifier"      foreground="{{text}}"/>
  <style name="def:type"            foreground="{{magenta}}"/>
  <style name="def:preprocessor"    foreground="{{cyan}}"/>
  <style name="def:reserved"        foreground="{{orange}}"/>
  <style name="def:error"           foreground="{{error}}" underline="error"/>
  <style name="def:warning"         foreground="{{warning}}" underline="single"/>
  <style name="def:note"            foreground="{{on_accent}}" background="{{yellow}}" bold="true"/>
  <style name="def:net-address"     foreground="{{link}}" underline="single"/>
  <style name="def:underlined"      underline="single"/>

  <!-- Markup -->
  <style name="def:heading"         foreground="{{blue}}" bold="true"/>
  <style name="def:emphasis"        italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code"     foreground="{{green}}"/>
  <style name="def:link-text"       foreground="{{link}}"/>
  <style name="def:link-destination" foreground="{{link_visited}}" underline="single"/>
  <style name="def:list-marker"     foreground="{{orange}}" bold="true"/>
  <style name="def:insertion"       foreground="{{green}}"/>
  <style name="def:deletion"        foreground="{{red}}" strikethrough="true"/>
  <style name="def:preformatted-section" foreground="{{green}}"/>
</style-scheme>
